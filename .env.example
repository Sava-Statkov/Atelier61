# Canonical address of the site (sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=

# true on staging: robots.txt disallows everything and pages get noindex.
NEXT_PUBLIC_NOINDEX=

# "published" or "all". Default: "all" in development, "published" in production builds.
CONTENT_MODE=

# Supabase project: the database, the photographs of the works and the admin sign-in.
# Production: Project Settings → API (project URL and the publishable / anon key).
# Locally: the values printed by `npx supabase status` (URL http://127.0.0.1:54321).
# Both are public by design; row level security protects the data. Never put a secret key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
